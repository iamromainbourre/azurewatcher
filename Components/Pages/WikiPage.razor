@page "/wiki"
@rendermode InteractiveServer
@inject WatcherService WatcherSvc
@implements IAsyncDisposable

@if (WatcherSvc.IsAuthenticated)
{
    <div class="controls-bar">
        <div class="view-toggle">
            <button class="view-btn @(!WikiSearchMode ? "view-btn--active" : "")"
                    @onclick="() => WikiSearchMode = false">☰ Browse</button>
            <button class="view-btn @(WikiSearchMode ? "view-btn--active" : "")"
                    @onclick="() => WikiSearchMode = true">⌕ Search</button>
        </div>
        @if (WikiSearchMode)
        {
            <div class="search-box" style="flex: 1">
                <span class="search-icon">⌕</span>
                <input type="text" placeholder="Search wiki content..."
                       @bind="WikiSearchQuery" @bind:event="oninput"
                       class="search-input"
                       @onkeydown="WikiSearchKeyDown" />
            </div>
            <button class="btn btn-ghost" @onclick="RunWikiSearch" disabled="@WatcherSvc.IsSearchingWiki">
                @if (WatcherSvc.IsSearchingWiki) { <span class="spinner spinner--small"></span> }
                Search
            </button>
        }
    </div>

    <div class="wiki-layout">
        <div class="wiki-panel">
            @if (!WikiSearchMode)
            {
                @if (WatcherSvc.IsLoadingWikis)
                {
                    <div class="card-loading">
                        <span class="spinner"></span>
                        <span>Loading wikis...</span>
                    </div>
                }
                else if (!WatcherSvc.WikiBrowseStates.Any())
                {
                    <div class="empty-state">No wikis found.</div>
                }
                else
                {
                    @foreach (var wikiState in WatcherSvc.WikiBrowseStates)
                    {
                        <div class="wiki-tree-wiki">
                            <button class="wiki-tree-header" @onclick="async () => await ToggleWikiExpand(wikiState)">
                                <span class="wiki-tree-chevron @(ExpandedWikis.Contains(wikiState.Wiki.Id) ? "wiki-tree-chevron--open" : "")">▶</span>
                                <span class="wiki-tree-wiki-name">@P(wikiState.Wiki.Name)</span>
                                <span class="subscription-count">@P(wikiState.Wiki.Project)</span>
                                @if (wikiState.IsLoading)
                                {
                                    <span class="spinner spinner--small" style="margin-left: 8px"></span>
                                }
                            </button>
                            @if (ExpandedWikis.Contains(wikiState.Wiki.Id))
                            {
                                @if (wikiState.IsLoading)
                                {
                                    <div class="card-loading" style="padding-left: 24px">
                                        <span>Loading pages...</span>
                                    </div>
                                }
                                else if (!wikiState.Pages.Any())
                                {
                                    <div class="card-loading" style="padding-left: 24px; color: var(--text-dim)">
                                        <span>No pages found.</span>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var page in wikiState.Pages.OrderBy(p => p.Order))
                                    {
                                        <WikiPageTreeNode Page="page"
                                                         OnPageSelected="async node => await LoadWikiPage(node, wikiState)"
                                                         SelectedPath="SelectedWikiPage?.Path"
                                                         Depth="0" />
                                    }
                                }
                            }
                        </div>
                    }
                }
            }
            else
            {
                @if (WatcherSvc.IsSearchingWiki)
                {
                    <div class="card-loading">
                        <span class="spinner"></span>
                        <span>Searching...</span>
                    </div>
                }
                else if (!WatcherSvc.WikiSearchResults.Any())
                {
                    <div class="empty-state">Type a query and press Search.</div>
                }
                else
                {
                    @foreach (var result in WatcherSvc.WikiSearchResults)
                    {
                        <div class="wiki-search-result" @onclick="async () => await LoadWikiPageFromSearch(result)">
                            <div class="devops-title">@P(result.FileName)</div>
                            <div class="devops-sub">@P(result.Project) / @P(result.WikiName) · @P(result.Path)</div>
                            @foreach (var snippet in result.Snippets)
                            {
                                <div class="wiki-search-snippet">@((MarkupString)snippet)</div>
                            }
                        </div>
                    }
                }
            }
        </div>

        @if (SelectedWikiPage != null)
        {
            <div class="sidebar-backdrop" @onclick="() => SelectedWikiPage = null"></div>
            <aside class="sidebar wiki-content-panel">
                <div class="sidebar-header">
                    <div class="sidebar-title">
                        <span class="sidebar-name">@P(SelectedWikiPage.WikiName)@P(SelectedWikiPage.Path)</span>
                        <span class="sidebar-sub">@P(SelectedWikiPage.Project)</span>
                    </div>
                    <a href="@SelectedWikiPage.Url" target="_blank" class="portal-link" style="flex-shrink: 0">↗</a>
                    <button class="sidebar-close" @onclick="() => SelectedWikiPage = null">✕</button>
                </div>
                <div class="sidebar-body">
                    <pre class="wiki-content-pre">@SelectedWikiPage.Content</pre>
                </div>
            </aside>
        }
    </div>
}

@code {
    private bool WikiSearchMode { get; set; }
    private string WikiSearchQuery { get; set; } = "";
    private HashSet<string> ExpandedWikis { get; set; } = new();
    private WikiPageContent? SelectedWikiPage { get; set; }

    private string P(string? value) => WatcherSvc.PrivacyMode ? "••••••" : (value ?? "");

    protected override async Task OnInitializedAsync()
    {
        WatcherSvc.OnStateChanged += OnStateChanged;
        if (WatcherSvc.IsAuthenticated)
            await WatcherSvc.EnsureWikisLoadedAsync();
    }

    private async Task ToggleWikiExpand(WikiBrowseState state)
    {
        if (ExpandedWikis.Contains(state.Wiki.Id))
        {
            ExpandedWikis.Remove(state.Wiki.Id);
        }
        else
        {
            ExpandedWikis.Add(state.Wiki.Id);
            await WatcherSvc.ExpandWikiAsync(state);
        }
    }

    private async Task LoadWikiPage(WikiPageNode page, WikiBrowseState state)
    {
        SelectedWikiPage = await WatcherSvc.LoadWikiPageAsync(
            state.Wiki.Project, state.Wiki.Id, state.Wiki.Name, page.Path);
    }

    private async Task LoadWikiPageFromSearch(WikiSearchResult result)
    {
        SelectedWikiPage = await WatcherSvc.LoadWikiPageAsync(
            result.Project, result.WikiId, result.WikiName, result.Path);
    }

    private async Task RunWikiSearch()
    {
        await WatcherSvc.SearchWikiAsync(WikiSearchQuery);
    }

    private async Task WikiSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunWikiSearch();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        WatcherSvc.OnStateChanged -= OnStateChanged;
    }
}

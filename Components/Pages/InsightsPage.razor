@page "/"
@rendermode InteractiveServer
@inject WatcherService WatcherSvc
@implements IAsyncDisposable

@if (!WatcherSvc.IsAuthenticated && !WatcherSvc.IsLoading)
{
    <div class="landing">
        <div class="landing-icon">◈</div>
        <h1>Azure Dashboard</h1>
        <p>Centralized monitoring of all your Application Insights resources across all your Azure subscriptions.</p>
        <button class="btn btn-primary btn-large" @onclick="InitDashboard">
            🔐 Sign in with your Azure account
        </button>
        <p class="landing-note">A browser window will open for Microsoft authentication.</p>
    </div>
}
else if (WatcherSvc.IsAuthenticated)
{
    @if (FullscreenMode)
    {
        <button class="fullscreen-exit-btn" @onclick='() => FullscreenMode = false' title="Exit fullscreen">✕ Exit Fullscreen</button>
    }

    @if (!FullscreenMode)
    {
        <div class="summary-bar">
            <div class="summary-card summary-card--critical">
                <span class="summary-count">@WatcherSvc.CriticalCount</span>
                <span class="summary-label">Critical</span>
            </div>
            <div class="summary-card summary-card--warning">
                <span class="summary-count">@WatcherSvc.WarningCount</span>
                <span class="summary-label">Warning</span>
            </div>
            <div class="summary-card summary-card--healthy">
                <span class="summary-count">@WatcherSvc.HealthyCount</span>
                <span class="summary-label">OK</span>
            </div>
            <div class="summary-card summary-card--total">
                <span class="summary-count">@WatcherSvc.Resources.Count</span>
                <span class="summary-label">Total</span>
            </div>
        </div>

        <div class="controls-bar">
            <div class="search-box">
                <span class="search-icon">⌕</span>
                <input type="text" placeholder="Filter by name, resource group, subscription, region..."
                       @bind="SearchTerm" @bind:event="oninput" class="search-input" />
            </div>
            <div class="filter-chips">
                <button class="chip @(StatusFilter == null ? "chip--active" : "")" @onclick="() => StatusFilter = null">All</button>
                <button class="chip chip--critical @(StatusFilter == HealthStatus.Critical ? "chip--active" : "")" @onclick="() => StatusFilter = HealthStatus.Critical">🔴 Critical</button>
                <button class="chip chip--warning @(StatusFilter == HealthStatus.Warning ? "chip--active" : "")" @onclick="() => StatusFilter = HealthStatus.Warning">🟡 Warning</button>
                <button class="chip chip--healthy @(StatusFilter == HealthStatus.Healthy ? "chip--active" : "")" @onclick="() => StatusFilter = HealthStatus.Healthy">🟢 OK</button>
            </div>
            <select class="sort-select" @bind="SortField">
                <option value="status">Sort by status</option>
                <option value="name">Name</option>
                <option value="errors">Errors</option>
                <option value="subscription">Subscription</option>
            </select>
            <select class="sort-select" @bind="GroupBy">
                <option value="none">No grouping</option>
                <option value="subscription">By subscription</option>
                <option value="status">By status</option>
            </select>
            <div class="view-toggle">
                <button class="view-btn @(ViewMode == "detailed" ? "view-btn--active" : "")"
                        @onclick='() => ViewMode = "detailed"'>⊞ Detailed</button>
                <button class="view-btn @(ViewMode == "compact" ? "view-btn--active" : "")"
                        @onclick='() => { ViewMode = "compact"; SelectedResource = null; }'>☰ Compact</button>
                <button class="view-btn" @onclick='() => { FullscreenMode = true; SelectedResource = null; }' title="Fullscreen cards">⛶ Full</button>
            </div>
        </div>

    }

    @if (SelectedResource != null)
    {
        <div class="sidebar-backdrop" @onclick="() => SelectedResource = null"></div>
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="status-indicator status-indicator--@SelectedResource.Status.ToString().ToLower()"></div>
                <div class="sidebar-title">
                    <span class="sidebar-name">@P(SelectedResource.Name)</span>
                    <span class="sidebar-sub">@P(SelectedResource.ResourceGroup) · @P(SelectedResource.SubscriptionName) · @P(SelectedResource.Location)</span>
                </div>
                <button class="sidebar-close" @onclick="() => SelectedResource = null">✕</button>
            </div>
            <div class="sidebar-body">
                @if (SelectedResource.Metrics != null)
                {
                    <div class="sidebar-metrics">
                        <div class="sidebar-metric">
                            <span class="metric-label">Failed requests</span>
                            <span class="metric-value metric-value--@(SelectedResource.Metrics.FailedRequestsLast5Min > 0 ? "bad" : "good")">
                                @SelectedResource.Metrics.FailedRequestsLast5Min.ToString("N0")
                            </span>
                        </div>
                        <div class="sidebar-metric">
                            <span class="metric-label">Failure rate</span>
                            <span class="metric-value metric-value--@(SelectedResource.Metrics.FailureRate > 5 ? "bad" : "good")">
                                @SelectedResource.Metrics.FailureRate.ToString("N1")%
                            </span>
                        </div>
                        <div class="sidebar-metric">
                            <span class="metric-label">Exceptions (1h)</span>
                            <span class="metric-value">
                                @SelectedResource.Metrics.ExceptionsLast5Min.ToString("N0")
                                <span class="trend trend--@SelectedResource.Metrics.ExceptionTrend.ToString().ToLower()">
                                    @TrendIcon(SelectedResource.Metrics.ExceptionTrend)
                                </span>
                            </span>
                        </div>
                    </div>
                    @if (SelectedResource.Metrics.ExceptionHistory.Any())
                    {
                        <div class="sparkline-container sidebar-chart">
                            <span class="sparkline-label">Exceptions — 24h</span>
                            <svg class="sparkline sidebar-sparkline" viewBox="0 0 120 30" preserveAspectRatio="none">
                                @foreach (var bar in BuildBars(SelectedResource.Metrics.ExceptionHistory))
                                {
                                    <rect x="@bar.X" y="@bar.Y" width="@bar.W" height="@bar.H" fill="#ef4444" />
                                }
                            </svg>
                        </div>
                    }
                    <div class="sidebar-footer">
                        <span class="updated-at">↻ @SelectedResource.Metrics.LastUpdated.ToLocalTime().ToString("HH:mm:ss")</span>
                        <a href="https://portal.azure.com/#resource@(SelectedResource.Id)/overview"
                           target="_blank" class="portal-link">View in Azure ↗</a>
                    </div>
                }
                else
                {
                    <div class="card-loading">
                        <span class="spinner"></span>
                        <span>Loading metrics...</span>
                    </div>
                }
            </div>
        </aside>
    }

    <div class="@(FullscreenMode ? "fullscreen-overlay" : "")">
        <div class="insights-layout">
            <div class="insights-content">
                @foreach (var section in DisplaySections)
                {
                    <div class="@(section.Header != null ? "subscription-group" : "")">
                        @if (section.Header != null)
                        {
                            <div class="subscription-header">
                                <span class="subscription-icon">@(GroupBy == "subscription" ? "☁" : "")</span>
                                <span class="subscription-name">@(GroupBy == "subscription" ? P(section.Header) : section.Header)</span>
                                <span class="subscription-count">@(section.Resources.Count()) resources</span>
                            </div>
                        }
                        @if (ViewMode == "compact")
                        {
                            <div class="resources-grid">
                                @foreach (var resource in section.Resources)
                                {
                                    <div class="resource-card resource-card--@resource.Status.ToString().ToLower() resource-card--compact @(SelectedResource == resource ? "card--selected" : "")"
                                         @onclick="() => SelectedResource = resource">
                                        <div class="card-header">
                                            <div class="status-indicator status-indicator--@resource.Status.ToString().ToLower()"></div>
                                            <div class="card-title">
                                                <span class="resource-name">@P(resource.ResourceGroup)</span>
                                                <span class="resource-rg">@P(resource.Name)</span>
                                            </div>
                                            <span class="resource-location">@P(resource.Location)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="resources-grid">
                                @foreach (var resource in section.Resources)
                                {
                                    <div class="resource-card resource-card--@resource.Status.ToString().ToLower() @(SelectedResource == resource ? "card--selected" : "")"
                                         @onclick="() => SelectedResource = resource" style="cursor:pointer">
                                        <div class="card-header">
                                            <div class="status-indicator status-indicator--@resource.Status.ToString().ToLower()"></div>
                                            <div class="card-title">
                                                <span class="resource-name">@P(resource.ResourceGroup)</span>
                                                <span class="resource-rg">@P(resource.Name)</span>
                                            </div>
                                            <span class="resource-location">@P(resource.Location)</span>
                                        </div>
                                        @if (resource.Metrics != null)
                                        {
                                            <div class="card-metrics">
                                                <div class="metric">
                                                    <span class="metric-label">Failed requests</span>
                                                    <span class="metric-value metric-value--@(resource.Metrics.FailedRequestsLast5Min > 0 ? "bad" : "good")">
                                                        @resource.Metrics.FailedRequestsLast5Min.ToString("N0")
                                                    </span>
                                                </div>
                                                <div class="metric">
                                                    <span class="metric-label">Failure rate</span>
                                                    <span class="metric-value metric-value--@(resource.Metrics.FailureRate > 5 ? "bad" : "good")">
                                                        @resource.Metrics.FailureRate.ToString("N1")%
                                                    </span>
                                                </div>
                                                <div class="metric">
                                                    <span class="metric-label">Exceptions (1h)</span>
                                                    <span class="metric-value">
                                                        @resource.Metrics.ExceptionsLast5Min.ToString("N0")
                                                        <span class="trend trend--@resource.Metrics.ExceptionTrend.ToString().ToLower()">
                                                            @TrendIcon(resource.Metrics.ExceptionTrend)
                                                        </span>
                                                    </span>
                                                </div>
                                            </div>
                                            @if (resource.Metrics.ExceptionHistory.Any())
                                            {
                                                <div class="sparkline-container">
                                                    <span class="sparkline-label">Exceptions — 24h</span>
                                                    <svg class="sparkline" viewBox="0 0 120 30" preserveAspectRatio="none">
                                                        @foreach (var bar in BuildBars(resource.Metrics.ExceptionHistory))
                                                        {
                                                            <rect x="@bar.X" y="@bar.Y" width="@bar.W" height="@bar.H" fill="#ef4444" />
                                                        }
                                                    </svg>
                                                </div>
                                            }
                                            <div class="card-footer">
                                                <span class="updated-at">↻ @resource.Metrics.LastUpdated.ToLocalTime().ToString("HH:mm:ss")</span>
                                                <a href="https://portal.azure.com/#resource@(resource.Id)/overview"
                                                   target="_blank" class="portal-link">View in Azure ↗</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="card-loading">
                                                <span class="spinner spinner--small"></span>
                                                <span>Loading metrics...</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                @if (!FilteredResources.Any())
                {
                    <div class="empty-state">No resources match your filters.</div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool FullscreenMode { get; set; } = false;
    private string SearchTerm { get; set; } = "";
    private HealthStatus? StatusFilter { get; set; }
    private string SortField { get; set; } = "status";
    private string GroupBy { get; set; } = "none";
    private string ViewMode { get; set; } = "detailed";
    private AppInsightsResource? SelectedResource { get; set; }

    private string P(string? value) => WatcherSvc.PrivacyMode ? "••••••" : (value ?? "");

    private record DisplaySection(string? Header, IEnumerable<AppInsightsResource> Resources);
    private IEnumerable<DisplaySection> DisplaySections => GroupBy == "none"
        ? new[] { new DisplaySection(null, FilteredResources) }
        : FilteredGrouped.Select(g => new DisplaySection(g.Key, g));

    private IEnumerable<AppInsightsResource> FilteredResources =>
        WatcherSvc.Resources
            .Where(r => StatusFilter == null || r.Status == StatusFilter)
            .Where(r => string.IsNullOrWhiteSpace(SearchTerm) ||
                        r.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                        r.ResourceGroup.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                        r.SubscriptionName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                        r.Location.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => SortField switch
            {
                "status" => (int)r.Status * -1,
                "name" => 0,
                "errors" => (int)-(r.Metrics?.FailedRequestsLast5Min ?? 0),
                _ => 0
            })
            .ThenBy(r => SortField == "name" ? r.Name : r.SubscriptionName);

    private IEnumerable<IGrouping<string, AppInsightsResource>> FilteredGrouped => GroupBy switch
    {
        "status" => FilteredResources.GroupBy(r => r.Status switch
        {
            HealthStatus.Critical => "🔴 Critical",
            HealthStatus.Warning  => "🟡 Warning",
            HealthStatus.Healthy  => "🟢 OK",
            _                     => "⚪ Unknown"
        }),
        _ => FilteredResources.GroupBy(r => r.SubscriptionName)
    };

    private record Bar(string X, string Y, string W, string H);

    private static List<Bar> BuildBars(List<double> history)
    {
        var maxVal = history.Max();
        var slotW = 120.0 / history.Count;
        var bars = new List<Bar>();
        for (int i = 0; i < history.Count; i++)
        {
            double h = maxVal > 0 && history[i] > 0 ? Math.Max(history[i] / maxVal * 28.0, 2.0) : 0;
            if (h > 0)
                bars.Add(new Bar(
                    (i * slotW + slotW * 0.15).ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                    (30.0 - h).ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                    (slotW * 0.7).ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                    h.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
                ));
        }
        return bars;
    }

    private static string TrendIcon(Trend trend) => trend switch
    {
        Trend.StrongIncrease => "↑↑",
        Trend.Increase => "↑",
        Trend.Decrease => "↓",
        _ => "→"
    };

    private async Task InitDashboard() => await WatcherSvc.InitializeAsync();

    protected override void OnInitialized()
    {
        WatcherSvc.OnStateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        WatcherSvc.OnStateChanged -= OnStateChanged;
    }
}
